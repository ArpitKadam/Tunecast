# Tunecast environment. Copy to .env for local runs; set the same names on the
# RunPod template. Never commit .env.
#
# Sections: 1) required on the pod, 2) optional on the pod, 3) local dev only,
# 4) CI secrets (GitHub, never in .env), 5) baked constants (reference only,
# not read from the environment).

# ---- 1. Required on the pod -------------------------------------------------
# Shared bearer key. Every API call except /health, /ready and the UI page
# must send "Authorization: Bearer <this>". Missing = server refuses to start
# (exit code 1).
TUNECAST_API_KEY=

# ngrok agent authtoken (dashboard -> "Your Authtoken"). NOT the ngrok REST
# API key; the tunnel will not start with an API key. Passed to the agent via
# its environment, never on the command line.
NGROK_AUTHTOKEN=

# Static ngrok domain the tunnel binds to, so the client URL never changes.
NGROK_DOMAIN=sliding-ethically-beckham.ngrok-free.dev

# ---- 2. Optional on the pod -------------------------------------------------
# Hugging Face token. Model is public; token only lifts download rate limits.
HF_TOKEN=

# Worker threads pulling from the job queue. 1 = one song at a time (never
# OOM). Clamped to 1..4.
TUNECAST_MAX_CONCURRENT=1

# How many finished songs to keep on the volume disk before the oldest
# succeeded ones are pruned. 200 songs of 3 min = ~4.6 GB. Minimum 1.
TUNECAST_KEEP_LAST=200

# Forwarded to the sgl-omni sidecar at boot when set
# (--dit_dav.factory.dit_steps / --dit_dav.factory.dit_cfg_scale). Leave blank
# for the official defaults. Not per-job: the official API has no per-job knobs.
TUNECAST_DIT_STEPS=
TUNECAST_DIT_CFG_SCALE=

# Pinned Hugging Face revision of MiniMaxAI/MiniMax-Music3. Baked default is
# fbdf52fbaaca799592917417eb05f1899f1255ec; only set to test a newer snapshot.
# The size manifest in tunecast/weights_manifest.json must match the revision.
TUNECAST_MODEL_REVISION=

# ---- 3. Local development only ----------------------------------------------
# 1 = no sgl-omni, no CUDA; a fake sidecar writes a 400 Hz sine WAV instead.
TUNECAST_STUB=0

# 0 = skip the ngrok tunnel (then NGROK_AUTHTOKEN / NGROK_DOMAIN not needed).
NGROK_ENABLED=1

# Root for models/, tunecast/outputs, jobs.db, logs. Pod default /workspace;
# stub-mode default ./.data. Only set to override.
TUNECAST_DATA_DIR=

# Ports (1..65535). API port is what ngrok and RunPod expose; sidecar port is
# localhost only. On this laptop 8080 is taken by PEM's Apache, use 8090.
TUNECAST_PORT=8080
TUNECAST_SIDECAR_PORT=8000

# ---- 4. CI secrets (GitHub repo -> Settings -> Secrets, NOT this file) -------
# DOCKERHUB_USERNAME   Docker Hub account that owns arpitkadam/tunecast.
# DOCKERHUB_TOKEN      Docker Hub access token with read/write scope; used
#                      only by .github/workflows/docker.yml to push the image.

# ---- 5. Baked constants (reference; changing them means editing code) -------
# Model and weights (tunecast/config.py, tunecast/weights.py)
#   MODEL_ID                 MiniMaxAI/MiniMax-Music3
#   MODEL_REVISION           fbdf52fbaaca799592917417eb05f1899f1255ec
#   MAX_CONCURRENT_CAP       4        hard cap for TUNECAST_MAX_CONCURRENT
#   MARKER                   .tunecast_complete   file in models dir holding the revision
# Request limits (tunecast/app.py)
#   MAX_DURATION_S           360      model cap: 9000 frames at 25 fps
#   MAX_LYRICS_CHARS         20000
#   MAX_DESCRIPTION_CHARS    10000
#   MAX_SEED                 2147483647
#   default duration_s       180
# Audio and sidecar protocol (tunecast/sidecar.py)
#   FRAMES_PER_SECOND        25       max_new_tokens = duration_s * 25
#   SAMPLE_RATE              32000    Hz, model output
#   CHANNELS                 2        stereo, 16-bit
#   sidecar HTTP timeout     duration_s * 10 + 120 seconds
#   MAX_ERROR_CHARS          2000     sidecar error body kept in job.error
#   stub TONE_HZ             400      stub sidecar sine tone
# Queue and progress (tunecast/jobs.py)
#   SEED_RATIO               0.6      inference seconds per audio second until measured
#   RATIO_WINDOW             10       jobs used for the median estimate
#   PROGRESS_CAP             0.95     progress fraction while running never exceeds this
#   STALE_ERROR              "pod restarted"   error set on jobs left running/queued at boot
# Boot and supervision (tunecast/boot.py, tunecast/tunnel.py)
#   SIDECAR_READY_TIMEOUT_S  1800     wait for sgl-omni to answer (exit 3 after)
#   TUNNEL_BIND_TIMEOUT_S    60       wait for the domain in ngrok's API (exit 4 after)
#   SIDECAR_POLL_S           2        poll interval for sidecar readiness
#   ngrok local API          http://127.0.0.1:4040
#   ngrok restart backoff    1 s doubling to 60 s
#   exit codes               1 config, 2 weights, 3 sidecar not ready, 4 tunnel not bound,
#                            5 sidecar died, 6 API port taken
# UI (tunecast/static/index.html)
#   localStorage key         tunecast_key
#   poll interval            3 s jobs, 10 s /ready
